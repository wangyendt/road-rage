extends "res://tests/test_stunts.gd"
func advance(seconds: float) -> void:
	for i in roundi(seconds*60): game._process(1.0/60)
	await process_frame
func capture(name: String) -> void:
	game.hud.queue_redraw()
	await process_frame
	await super.capture(name)
func run() -> void:
	game=load("res://scenes/main.tscn").instantiate()
	game.test_mode=true
	root.add_child(game)
	game.set_process(false)
	prepare()
	await key(KEY_E)
	check(not game.stunt.active,"grounded E does not detach rider")
	launch()
	await key(KEY_E)
	check(game.stunt.active,"E starts airborne trick in real input path")
	await advance(0.42)
	await capture("v45-superman")
	check(game.player.rider.position.y>2.5 and absf(game.player.rider.rotation.x)>1,"native model shows elevated horizontal rider")
	check(not game.mirror_camera.get_cull_mask_value(2) and game.camera.get_cull_mask_value(2),"mirror excludes local rider while main view retains it")
	check(game.player.rider.find_children("*","GeometryInstance3D",true,false).all(func(n): return n.layers==2),"all separating rider geometry uses mirror-exclusion layer")
	var screen=game.camera.unproject_position(game.player.rider.global_position)
	check(game.hud.get_viewport_rect().has_point(screen),"separated rider remains inside camera view")
	var weapon=game.loadout.current
	await key(KEY_Q)
	check(game.loadout.current==weapon,"weapon switching waits until remount")
	await key(KEY_J)
	check(game.player.attack_time==0,"attack input does not overwrite airborne pose")
	await key(KEY_P)
	var extension=game.stunt.extension
	await advance(0.6)
	check(game.state=="paused" and game.stunt.extension==extension,"native pause freezes separation")
	await key(KEY_P)
	await advance(1.1)
	await capture("v45-remounted")
	check(not game.stunt.active and game.stunt.pending_bonus,"animation automatically completes remount in midair")
	check(game.player.rider.position.is_equal_approx(Vector3(0,1.4,0.2)),"native rider is reseated without find-bike animation")
	for frame in 900:
		game._process(1.0/60)
		if game.stunts>0: break
	await capture("v45-landing")
	check(game.health==100 and game.crashes==0 and game.stunts==1,"rendered landing has bonus with no vehicle damage")
	check(game.bounces>0 and game.rebound_timer>0,"landing still visibly rebounds")
	game.distance=game.track_length
	game.finish_race("finished")
	await advance(1.6)
	await capture("v45-results")
	check(game.stunts==1 and game.race_income.gross>0,"results retain stunt total and ordinary finish payout")
	await click("menu")
	await click("settings")
	await click("bindings")
	check(game.hud.buttons.filter(func(b): return b.action.begins_with("bind:")).size()==13,"all thirteen actions fit in keybinding layout")
	await click("bind:aerial_stunt")
	await key(KEY_X)
	check(game.controls.keys.aerial_stunt==KEY_X,"stunt key is rebindable through the UI")
	await capture("v45-bindings")
	await key(KEY_ESCAPE)
	await key(KEY_ESCAPE)
	await click("help")
	await capture("v45-help")
	check(game.state=="help","guide includes new trick action and landing rule")
	await key(KEY_ESCAPE)
	launch()
	await key(KEY_E)
	check(not game.stunt.active,"old E binding no longer triggers trick")
	await key(KEY_X)
	check(game.stunt.active,"new X binding triggers trick")
	game.start_race()
	check(not game.stunt.active and not game.player.stunt_pose_active and game.stunts==0,"retry clears active pose and score counters")
	print("STUNT_UI_TEST_RESULTS passed=%d failed=%d"%[passed,failed])
	game.sound.shutdown()
	game.queue_free()
	await create_timer(0.4).timeout
	quit(1 if failed else 0)
